# Server-only URL for the Private AI Business Agent public synthetic demo API.
# Local development:
PRIVATE_AI_DEMO_API_URL=http://127.0.0.1:8000

# Optional server-to-server bearer token. Leave empty while the demo API is public.
PRIVATE_AI_DEMO_API_KEY=

# Website lead delivery — preferred production path.
# Create a sending-only Resend API key and verify alvorem.ro before using hello@alvorem.ro as sender.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@alvorem.ro
CONTACT_FROM_EMAIL=ALVOREM <hello@alvorem.ro>

# Optional alternate/fallback webhook delivery path.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_BEARER_TOKEN=
